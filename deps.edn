{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout — a standalone fork should override them
 ;; with git coordinates.
 ;;
 ;; senkyo carries the per-jurisdiction filing catalog (what must be
 ;; received, by whom, by when, and what the formal review covers). The
 ;; FILING side (cloud-itonami-isic-9492) reads the SAME table from the
 ;; other direction — deliberately, so a discrepancy between what a
 ;; campaign is told to submit and what an authority is told to receive
 ;; cannot arise from two divergent copies.
 ;; jp-go-digital-design-system is the workspace-wide BASE design system;
 ;; the build-time console renderer uses its compat skin so the generated
 ;; page needs no hand-written CSS. Pinned by git sha (not :local/root) so
 ;; a standalone fork resolves it too.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/senkyo
        {:local/root "../../kotoba-lang/senkyo"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "electoralops.sim"]}
  ;; clojure -M:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by running the REAL actor
  ;; (flagship checklist item 2). Refuses to write the file if the run
  ;; produced no hard governor holds.
  :render-html {:main-opts ["-m" "electoralops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
